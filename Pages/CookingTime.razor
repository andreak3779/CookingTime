@* filepath: Pages/CookingTime.razor *@

@page "/cooking-time"

@inject ICookingTimeCalculator Calculator
@inject IMealFactory MealFactory

<PageTitle>Cooking Time Calculator</PageTitle>

<h1 class="ct-page-title">Cooking Time Calculator</h1>

<EditForm Model="@_model" OnValidSubmit="@HandleSubmit" FormName="cooking-time" class="ct-card ct-form">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="ct-field">
        <label class="ct-label" for="meal">Cooking Type:</label>
        <InputSelect id="meal" class="ct-select" @bind-Value="_model.Meal" TValue="string">
            <option value="">Select a meal...</option>
            @foreach (var meal in _meals)
            {
                <option value="@meal.Name">@meal.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="() => _model.Meal" />
    </div>

    <div class="ct-field">
        <label class="ct-label" for="weight">Cooking Weight:</label>
        <InputNumber id="weight" class="ct-input" @bind-Value="_model.Weight" TValue="decimal" />
        <ValidationMessage For="() => _model.Weight" />
    </div>

    <div class="ct-field">
        <label class="ct-label">Units:</label>
        <InputRadioGroup Name="unit" @bind-Value="_model.Unit">
            <div class="ct-segmented">
                <label><InputRadio Name="unit" Value="@WeightUnit.Pounds" /> Pounds</label>
                <label><InputRadio Name="unit" Value="@WeightUnit.Kilograms" /> Kilograms</label>
            </div>
        </InputRadioGroup>
    </div>

    <div class="ct-actions">
        <button type="submit" class="ct-btn">Calculate</button>
        <button type="button" class="ct-btn ct-btn--ghost" @onclick="Reset">Reset</button>
    </div>
</EditForm>

@if (_result is not null)
{
    <section class="ct-results">
        <div class="ct-result">
            <h2>Cooking Time</h2>
            <p class="ct-result__time">@_result.FormattedDuration</p>
        </div>

        <div class="ct-card ct-card--flat">
            <h3>Cooking Instructions</h3>
            <p>@_result.Instructions</p>
        </div>

        @if (!_result.IsSuccess)
        {
            <ul class="validation-errors">
                @foreach (var error in _result.ValidationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        }
    </section>
}

@code {
    private CookingTimeViewModel _model = new();
    private IReadOnlyList<IMeal> _meals = Array.Empty<IMeal>();
    private CookingResult? _result;

    /// <summary>
    /// Optional initial model state. Used by component tests to pre-fill the form
    /// and avoid flaky bUnit input-binding timing. Production code does not set this.
    /// </summary>
    [Parameter] public CookingTimeViewModel? InitialModel { get; set; }

    protected override void OnInitialized()
    {
        if (InitialModel is not null)
            _model = InitialModel;
        _meals = MealFactory.CreateAll()
            .OrderBy(m => m.Name, StringComparer.Ordinal)
            .ToList();
    }

    public async Task SubmitAsync() => await HandleSubmit();

    private async Task HandleSubmit()
    {
        _result = await Calculator.CalculateAsync(_model.Meal, _model.Weight, _model.Unit);
    }

    private void Reset()
    {
        // Phase 17: assign a NEW model instance rather than mutating the
        // existing one.
        //
        // EditForm holds an EditContext over the model instance, and
        // DataAnnotationsValidator caches per-field messages in its
        // ValidationMessageStore. Mutating the model does NOT clear that
        // store, so after a failed submit the old validation messages stayed
        // on screen after Reset - the form looked reset but still showed
        // "Please select a meal."
        //
        // Replacing the instance makes EditForm bind a fresh model, and the
        // stale messages go with it.
        _model = new CookingTimeViewModel();
        _result = null;
    }

    public sealed class CookingTimeViewModel
    {
        [Required(ErrorMessage = "Please select a meal.")]
        public string Meal { get; set; } = "";

        [Range(0.01, 999.0, ErrorMessage = "Please enter a weight between 0.01 and 999.")]
        public decimal Weight { get; set; } = 1M;

        public WeightUnit Unit { get; set; } = WeightUnit.Pounds;
    }
}
