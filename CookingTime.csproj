<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CookingTime</RootNamespace>
    <AssemblyName>CookingTime</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Phase 6: limit the production compile glob to the four folders
         that ship with the app. The default Blazor SDK glob would also
         pick up tests/**/*.cs and Bundle/Backup/*.cs.
           - tests/ lives under separate csproj data and includes
             xUnit/FluentAssertions attributes that aren't valid in the
             production assembly.
           - Backup/ is the historical reference project and is
             intentionally not built. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0-*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0-*" PrivateAssets="all" />
  </ItemGroup>

  <!-- Make the generated Program type visible to the test assembly so
       WebApplicationFactory tests can find an entry point. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CookingTime.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Application\**\*.cs" />
    <Compile Include="Domain\**\*.cs" />
    <Compile Include="Infrastructure\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <RazorComponent Include="App.razor" />
    <RazorComponent Include="Routes.razor" />
    <RazorComponent Include="_Imports.razor" />
    <RazorComponent Include="Layout\**\*.razor" />
    <RazorComponent Include="Pages\**\*.razor" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**\*" Pack="false" />
  </ItemGroup>

</Project>
