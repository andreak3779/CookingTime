<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CookingTime</RootNamespace>
    <AssemblyName>CookingTime</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Phase 1: disable the SDK's auto-globbing for compile, embedded resource, and Razor page items.
         The Blazor csproj only needs explicit items we list below; this stops the SDK from
         picking up the legacy WinForms .resx and .cs files sitting at the repo root. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0-*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0-*" PrivateAssets="all" />
  </ItemGroup>

  <!-- Make the generated Program type visible to the test assembly so
       WebApplicationFactory<Program> can find an entry point. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CookingTime.UnitTests" />
  </ItemGroup>

  <!-- Explicit compile glob: only the Blazor app source.
       With EnableDefaultCompileItems / EnableDefaultEmbeddedResourceItems / EnableDefaultRazorGenerateItems
       all disabled, we must declare the .cs files and the .razor files separately. The Blazor SDK's
       Razor targets will pick up <RazorComponent> items. -->
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <RazorComponent Include="App.razor" />
    <RazorComponent Include="Routes.razor" />
    <RazorComponent Include="_Imports.razor" />
    <RazorComponent Include="Layout\**\*.razor" />
    <RazorComponent Include="Pages\**\*.razor" />
  </ItemGroup>

  <!-- wwwroot static assets; nothing else gets shipped to the host. -->
  <ItemGroup>
    <None Include="wwwroot\**\*" Pack="false" />
  </ItemGroup>

</Project>
