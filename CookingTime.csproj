<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CookingTime</RootNamespace>
    <AssemblyName>CookingTime</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Phase 6 + Phase 8: limit the production compile glob to the four
         folders that ship with the app. The default Blazor SDK glob
         would also pick up tests/**/*.cs and OriginalSource/*.cs.
           - tests/ lives under separate csproj data and includes
             xUnit/FluentAssertions attributes that aren't valid in the
             production assembly.
           - OriginalSource/ is the historical reference project
             (renamed from Backup/ in Phase 8) and is intentionally not
             built. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Phase 12: the Razor SDK's default glob is Content Include="**\*.razor"
         (Sdk.Razor.CurrentVersion.props). Without this, EVERY .razor file under
         the project root is compiled into the app - including reference
         material such as the design package under docs/design/. Two
         components claiming the same route throws
         "InvalidOperationException: The following routes are ambiguous"
         in the browser at router-boot time, while the build stays green and
         every server-side test still passes.
         A static <RazorComponent Remove="docs\**" /> does NOT work: the
         default items are added inside the ResolveRazorComponentInputs
         target, after evaluation-time Remove has already run.
         Setting this to false makes the component set explicit - every
         .razor in the app is named in the <RazorComponent Include="..." />
         items below. This completes the opt-out that EnableDefaultCompileItems
         and EnableDefaultEmbeddedResourceItems already perform for .cs/.resx.
         See docs/decisions/0007-design-package-as-reference-artifact.md. -->
    <EnableDefaultRazorComponentItems>false</EnableDefaultRazorComponentItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

    <!-- Phase 16 follow-up: disable the SDK's implicit WASM HotReload
         package reference.

         The .NET SDK adds an implicit
         PackageReference to Microsoft.DotNet.HotReload.WebAssembly.Browser
         when Configuration == Debug (see Sdk.targets: _WasmEnableHotReload
         defaults to false for every non-Debug configuration). That makes the
         dependency graph CONFIGURATION-DEPENDENT, and the packages.lock.json
         is not: the Debug graph has one package the Release graph does not.

         The consequence was a broken CI restore:

             error NU1004: The package references have changed for net10.0.
             Lock file's package references: ... Microsoft.NET.Sdk.WebAssembly.Pack:[10.0.15, ),
             project's package references: ... Microsoft.DotNet.HotReload.WebAssembly.Browser >= 10.0.115 ...

         because CI restores in Debug by default while the committed lock file
         had been generated in Release.

         Turning HotReload off makes the graph identical in every
         configuration, so one committed lock file is valid for all of them.
         The cost is losing the browser-side hot reload for Blazor WASM -
         a developer convenience, not a capability the app depends on.

         The property is the PUBLIC one (WasmEnableHotReload); the SDK's
         private _WasmEnableHotReload derives from it. -->
    <WasmEnableHotReload>false</WasmEnableHotReload>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phase 16: versions are pinned exactly.
         These were floating ("10.0.0-*"), which resolves to the highest
         10.0.x patch at restore time. Two builds of the same commit could
         therefore pull different package versions, and a newly published
         patch would be picked up silently. packages.lock.json (committed,
         enabled by RestorePackagesWithLockFile in Directory.Build.props)
         pins the whole transitive graph on top of this. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Make the generated Program type visible to the test assembly so
       WebApplicationFactory tests can find an entry point. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CookingTime.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Application\**\*.cs" />
    <Compile Include="Domain\**\*.cs" />
    <Compile Include="Infrastructure\**\*.cs" />
    <!-- Belt-and-suspenders: OriginalSource/ is the legacy WinForms
         reference project (Phase 8). It must stay in git as historical
         context, but never enter the production assembly. The
         Directory.Build.props DefaultItemExcludes and this csproj's
         EnableDefaultCompileItems=false already cover this; this Remove
         is redundant but makes the intent explicit at the build rule
         level for any future project that opts into default items. -->
    <Compile Remove="OriginalSource\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 12: Routes.razor was removed. Routing now lives in App.razor
         (the .NET 10 template shape); a second Router over the same assembly
         would build a second route table. -->
    <RazorComponent Include="App.razor" />
    <RazorComponent Include="_Imports.razor" />
    <RazorComponent Include="Layout\**\*.razor" />
    <RazorComponent Include="Pages\**\*.razor" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**\*" Pack="false" />
  </ItemGroup>

</Project>
