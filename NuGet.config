<?xml version="1.0" encoding="utf-8"?>
<!--
  filepath: NuGet.config

  Phase 16: pin the package sources and stop a transitive dependency from
  silently arriving from a different feed.

  <clear /> removes any source inherited from a machine-level or user-level
  NuGet.config. Without it, a developer's machine could restore from an
  extra feed - a private mirror, a local folder - and the build would
  differ from CI without anything in the repository changing.

  packageSourceMapping then states, per source, which package IDs may come
  from it. A package that is not allowed by any mapping entry fails to
  restore instead of being pulled from whatever source happens to be
  configured. The mapping covers the two package prefixes this repository
  actually uses: Microsoft.* (the .NET platform and ASP.NET Core) and the
  test-tooling set (xunit, Moq, FluentAssertions, bunit, coverlet,
  Test.Sdk).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
      <package pattern="NETStandard.*" />
      <package pattern="xunit" />
      <package pattern="xunit.*" />
      <package pattern="Moq" />
      <package pattern="FluentAssertions" />
      <package pattern="bunit" />
      <package pattern="bunit.*" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="coverlet.*" />
      <package pattern="AngleSharp*" />
      <package pattern="Castle.Core" />
    </packageSource>
  </packageSourceMapping>
</configuration>
