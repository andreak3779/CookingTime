@* filepath: Pages/Index.razor *@

@page "/"

<PageTitle>Cooking Time</PageTitle>

<div class="ct-card" style="display:flex;flex-direction:column;gap:16px;align-items:flex-start">
    <img src="icons/icon.svg" width="72" height="72" alt="" />
