<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CookingTime.IntegrationTests</RootNamespace>
    <AssemblyName>CookingTime.IntegrationTests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Phase 5: test-only host. Lives under tests/ so it is never
         published or deployed. WebApplicationFactory<Marker> binds
         to the Marker type in this assembly. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Rename the host entry point so it does not collide with the
         Main that Microsoft.NET.Test.Sdk auto-generates as the test
         runner entry point. -->
    <StartupObject>CookingTime.IntegrationTests.TestHost</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="1.31.3" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.0-*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0-*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Phase 7: coverlet.collector hooks into the test runner so the
         dotnet test runner (with XPlat Code Coverage enabled) emits a
         Cobertura XML per test project. See UnitTests.csproj for the
         full rationale. -->
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CookingTime.csproj" />
  </ItemGroup>

  <!-- The test host uses the same appsettings.json as the WASM client so
       IOptions<MealCatalogOptions> and IOptions<ProductInfoOptions> resolve
       identically in both runtimes. The Link keeps the file physically
       in the repo root to avoid duplication. -->
  <ItemGroup>
    <None Include="..\..\appsettings.json"
          Link="appsettings.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- bUnit 1.x pulls in AngleSharp < 1.3.0 (CVE GHSA-pgww-w46g-26qg).
       Microsoft.AspNetCore.Mvc.Testing 10.0.0-* pulls in
       Microsoft.Extensions.Caching.Memory 9.0.0-preview.7 (NU1903).
       Scoped to this test project only; production code keeps
       TreatWarningsAsErrors without these suppressions. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

</Project>
