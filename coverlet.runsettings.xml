<?xml version="1.0" encoding="utf-8"?>
<!--
  filepath: coverlet.runsettings.xml

  Phase 7 + Phase 8: coverlet filter rules for all three test projects.
  The Include list covers the production-code namespaces we want coverage
  on. OriginalSource/* is automatically excluded because its namespace
  is just "OriginalSource" (no CookingTime. prefix), so it never matches
  an Include pattern; the explicit Exclude below is defensive only.

  Excluded: all test-assembly namespaces, OriginalSource/* (historical
  reference, renamed from Backup/ in Phase 8), and generated/Designer
  files (none today, but cheap insurance).

  Coverlet consumes this file when invoked via the dotnet test runner
  with XPlat Code Coverage enabled and the settings flag pointed here.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[CookingTime.Domain.*]</Include>
          <Include>[CookingTime.Application.*]</Include>
          <Include>[CookingTime.Infrastructure.*]</Include>
          <Include>[CookingTime.Pages.*]</Include>
          <Include>[CookingTime.Layout.*]</Include>
          <Exclude>[CookingTime.UnitTests.*]</Exclude>
          <Exclude>[CookingTime.ComponentTests.*]</Exclude>
          <Exclude>[CookingTime.IntegrationTests.*]</Exclude>
          <Exclude>[OriginalSource.*]</Exclude>
          <Exclude>[*.Generated]*</Exclude>
          <ExcludeByFile>**/*.designer.cs</ExcludeByFile>
          <SingleHit>false</SingleHit>
          <UseFileMode>true</UseFileMode>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>