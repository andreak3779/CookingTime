<!-- filepath: Directory.Build.props

  Phase 7: shared MSBuild properties applied to every project under this
  directory tree. Currently only the three test projects opt into coverlet
  via <CollectCoverage>; production code (CookingTime.csproj) doesn't set
  this flag and is unaffected.

  Coverlet reads coverlet.runsettings.xml next to the repo root for the
  include/exclude namespace filters; this file only configures the
  output format and target folder. Test projects inherit the
  <CollectCoverage>true</CollectCoverage> automatically when they reference
  coverlet.collector, but we set it explicitly here so that running the
  test runner with XPlat Code Coverage enabled works the same whether or
  not the per-test-project csproj opts in. -->
<Project>

  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)TestResults/coverage/</CoverletOutput>
    <IncludeTestAssembly>false</IncludeTestAssembly>
    <UseFileMode>true</UseFileMode>
    <DefaultItemExcludes>$(DefaultItemExcludes);OriginalSource\**;tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Phase 16: reproducible restores.
       RestorePackagesWithLockFile makes `dotnet restore` write (and then
       honour) a packages.lock.json per project. Combined with exact
       PackageReference versions, the whole transitive dependency graph is
       pinned: the same commit restores the same packages on every machine
       and every CI run.

       The lock files are committed. A restore that would change the graph
       fails with NU1004 unless the lock file is regenerated deliberately
       (`dotnet restore -force-evaluate`), which makes a dependency change
       an explicit, reviewable diff rather than a side effect of a restore.

       LockedMode is deliberately NOT set: the test projects reference each
       other and their graph differs between Debug and Release, which would
       otherwise make the build fail on a legitimate change. The committed
       lock file plus exact versions is the guarantee that matters here. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>